generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 分类 ====================
model Category {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  books     Book[]
  createdAt DateTime @default(now())
}

// ==================== 采集规则 ====================
model Rule {
  id          String   @id @default(cuid())
  name        String
  description String?
  // 完整规则配置 JSON (list/book/toc/content 四段 + fetch + clean)
  config      String   @default("{}")
  enabled     Boolean  @default(true)
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== 书籍 ====================
model Book {
  id            String    @id @default(cuid())
  // 伪静态数字书号(应用层分配 max+1; SQLite 单自增列限制不能用 autoincrement)。
  // 伪静态 URL /book/{num}.html 的标识符; null 时前台链接自动回退查询串形态(永不死链)
  num           Int?      @unique
  name          String
  author        String    @default("佚名")
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  intro         String    @default("")
  cover         String    @default("") // 外链URL 或本地相对路径 covers/xxx.webp
  // unknown | ongoing | completed (智能判断完结)
  status        String    @default("unknown")
  keywords      String    @default("") // 主关键词(站内SEO)
  latestChapter String    @default("")
  wordCount     Int       @default(0)
  sourceUrl     String    @default("")
  sourceRuleId  String?
  // db | txt
  storageMode   String    @default("db")
  collectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chapters Chapter[]
  tags     BookTag[]
  downloads DownloadJob[]
  // [R27-2-2] PSEO 关键词落地页(主书关联; 页面删除时书保留)
  pseoPages PseoPage[]

  @@index([categoryId])
  @@index([updatedAt])
  // wordCount 排序消费: /api/public/books?sort=words / /api/public/search / /api/public/categories 代表书
  @@index([wordCount])
}

// ==================== 章节 ====================
model Chapter {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  idx       Int // 排序序号(乱序重排后)
  title     String
  volume    String @default("") // 分卷名(kk-a): 规则 toc.fields.volume 提取; UI 按卷分组
  url       String   @default("") // 源章节地址(去重用)
  content   String?  // db模式正文(清洗后html)
  // db | txt
  storage   String   @default("db")
  filePath  String?  // txt模式文件路径
  wordCount Int      @default(0)
  fetched   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, idx])
  @@index([bookId, url])
  @@index([updatedAt])
  // [R11-a2-1] 仪表盘 7 日入库曲线索引 —— GET /api/admin/stats 的 countPerDay7d('chapter')
  //  按本地自然日做 7 次 count({ createdAt: gte/lt }), 修前 Chapter 无任何 createdAt 索引,
  //  每次仪表盘加载(前端 5~10s 轮询)都对最大表(章节行数随采集无界增长, 生产可达数十万行)
  //  全表扫描 7 次; 补 createdAt 索引后转为窄区间扫描
  @@index([createdAt])
}

// ==================== 书籍标签(搜索引擎下拉词) ====================
model BookTag {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    String
  // suggest | manual
  source String @default("suggest")
  hits   Int    @default(0)

  @@unique([bookId, tag])
  @@index([tag])
}

// ==================== 采集任务 ====================
model Task {
  id     String @id @default(cuid())
  name   String
  ruleId String
  rule   Rule   @relation(fields: [ruleId], references: [id])
  // single(单本) | range(范围) | bookIds(书号) [R34-2a-1]
  //  [R35-2a-2] bookIds(书号)模式含两种子形态: 书号列表(bookIds 非空)与书号范围(bookIdFrom/bookIdTo
  //  均非空), 二者互斥由 API validateTaskPair 执法; 两者均空则视为空任务(启动后队列空)
  mode      String @default("single")
  bookUrl   String @default("") // 单本模式: 书籍页地址; bookIds 模式: 书籍页URL模板(必含 {bookId} 占位符)
  // bookIds(书号)模式: 书号原文(换行分隔, 由 API 规范化: trim/去空/去重) [R34-2a-1]
  bookIds   String @default("")
  // [R35-2a-2] bookIds(书号)模式范围子形态: 起止书号(存数字字符串, trim; 空串=未用范围形式)。
  //  运行时展开为 from..to 数字序列渲染 {bookId} 模板灌 bookQueue(上限 2000 本与列表形式同口径)
  bookIdFrom String @default("")
  bookIdTo   String @default("")
  // 范围模式: 列表页 {page} 起止
  listUrl   String @default("")
  listStart Int    @default(1)
  listEnd   Int    @default(1)
  // 范围模式: 列表内书籍序号起止(0=不限)
  bookStart Int    @default(0)
  bookEnd   Int    @default(0)
  // full(完全覆盖重采集) | incremental(只增量更新)
  recrawlMode String @default("incremental")
  // db | txt
  storageMode String @default("db")
  // 反反爬覆盖配置(可选, 空则用规则默认)
  fetchConfig String @default("{}")
  // 线程数随机范围
  threadMin   Int    @default(1)
  threadMax   Int    @default(3)
  // 间隔毫秒随机范围
  intervalMin Int    @default(500)
  intervalMax Int    @default(2000)
  smartCategory Boolean @default(true)
  smartComplete Boolean @default(true)
  autoSuggest   Boolean @default(true)
  // 采集完成后自动按间隔重启(实时更新模式)
  autoRefresh        Boolean @default(false)
  refreshIntervalMin Int     @default(30) // 完成后N分钟重新采集, 钳 5~1440
  // pending | running | paused | stopped | done | error
  status    String   @default("pending")
  // 运行时进度快照 JSON
  progress  String   @default("{}")
  stats     String   @default("{}")
  logs      TaskLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // info | success | warn | error
  level     String   @default("info")
  message   String
  createdAt DateTime @default(now())

  @@index([taskId, id])
  // [R11-a2-1] 日志保留期清扫索引 —— 两处读路径顺手 deleteMany({ createdAt: lt 30天前 })
  //  均按 createdAt 过滤: GET /api/admin/stats(仪表盘每次轮询)与 GET /api/admin/tasks/[id]/logs。
  //  修前仅 (taskId, id) 索引, stats 侧的全局清理(无 taskId 条件)必然全表扫描
  @@index([createdAt])
}

// ==================== 站群站点 ====================
model Site {
  id      String @id @default(cuid())
  name    String
  domain  String @unique // 例: www.a.com (含端口亦可)
  themeId String @default("aurora")
  // TDK
  title       String @default("")
  description String @default("")
  keywords    String @default("")
  // SEO/GEO 扩展
  icbm        String @default("35.86166,104.195397") // geo 坐标
  geoRegion   String @default("CN")
  geoPlacename String @default("中国")
  // 书籍列表偏移量(站群差异化)
  offset      Int    @default(0)
  isDefault   Boolean @default(false)
  status      Boolean @default(true)
  // 站群链轮: 是否参与其他站点页脚的互链(缺省参与)
  inLinkWheel Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== TXT下载任务 ====================
model DownloadJob {
  id      String @id @default(cuid())
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // 注入选项 JSON: ads/obfuscate/siteInfo/header/footer 等
  options String @default("{}")
  // pending | running | done | error
  status   String  @default("pending")
  filePath String?
  error    String?
  size     Int     @default(0)
  createdAt DateTime @default(now())

  // [R11-c-3] 公开下载读路径索引 —— /api/public/download?book=<id> 走 findFirst({bookId,
  // status, filePath not null} orderBy createdAt desc), 修前 DownloadJob 无任何 bookId 索引,
  // 该端点无鉴权且每次下载请求都触发一次全表扫描(任务行随下载历史无界增长)。
  // 复合序 (bookId, status, createdAt) 与查询形态精确匹配(status 等值 + createdAt 排序取最新)
  @@index([bookId, status, createdAt])
}

// ==================== 全局设置 ====================
model Setting {
  key   String @id
  value String @default("{}")
}

// ==================== [R42-1] 免费代理池 ====================
// 自动抓取全网免费代理(harvester 多源) + 并发验证(validator) + 规则启动前匹配(selector)。
// 消费链: 采集规则/任务 fetchConfig.needsProxy=true 且未显式配 proxyUrl 时, runner 启动前
// 从本表按 国别/协议/健康分 挑选代理写入任务 fetchConfig.proxyUrl → 既有 pickProxyFor
// 轮换机制原样接管(http/curl/browser/scrapling 四链全兼容, 零引擎改动)。
model FreeProxy {
  id            String    @id @default(cuid())
  // 存储归一: https→http, socks5h→socks5(与 fetcher scheme 白名单 http/https/socks5(h)/socks4(a) 同口径)
  protocol      String
  host          String
  port          Int
  // transparent | anonymous | elite | ""(未知; 来源标注或 ip-api anonymity 字段)
  anonymity     String    @default("")
  country       String    @default("") // ISO 3166-1 alpha-2 出口国别(US/CN/HK...)
  countryName   String    @default("")
  exitIp        String    @default("") // 验证时出口 IP(ip-api query; 判断代理是否匿名)
  latencyMs     Int?
  alive         Boolean   @default(false)
  successCount  Int       @default(0)
  failCount     Int       @default(0)
  // 0~100 健康分(成功 +15 封顶 / 失败 ×0.3 衰减; pickProxiesForRule 降序消费)
  healthScore   Int       @default(0)
  lastError     String    @default("")
  source        String    @default("") // 首次收录来源源 ID
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([protocol, host, port])
  @@index([alive, healthScore])
  @@index([country, alive])
  @@index([lastCheckedAt])
}

// ==================== [R27-2] PSEO 关键词落地页 ====================
// 搜索下拉词/模板词 → SEO 落地页, 路径 /p/{slug}.html(伪静态 catch-all 分支)。
// 注意: Prisma 基本类型不能用数组 → matchedBookIds 存 JSON 字符串(参照 BookTag 多值先例)。
model PseoPage {
  id        String   @id @default(cuid())
  // 生成时的主站点(默认启用站; 站群 canonical/site 参数兜底), 可空
  siteId    String?
  // 目标关键词(全站唯一, 防同词内耗竞争)
  keyword   String   @unique
  // 路径段(不含 /p/ 前缀与 .html 后缀; CJK 清洗 + 短哈希后缀防碰撞), 全站唯一
  slug      String   @unique
  // 页面标题(H1 + <title> 基底, 不含站名后缀 — 站名由 SSR 按站群上下文追加)
  title       String @default("")
  description String @default("")
  keywords    String @default("")
  // 主书籍(页面主体; 书删除时置空, 页面转纯模板页仍可渲染)
  primaryBookId String?
  primaryBook   Book?  @relation(fields: [primaryBookId], references: [id], onDelete: SetNull)
  // 相关书籍 id 列表(JSON 字符串数组, 主书在最前; 页面按此渲染书卡列表)
  matchedBookIds String @default("[]")
  // active | disabled(前台仅渲染 active)
  status  String @default("active")
  // template | suggest (生成来源, 统计口径)
  source  String @default("suggest")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([primaryBookId])
}

// ==================== 友情链接 ====================
model FriendLink {
  id        String   @id @default(cuid())
  name      String // 锚文本(站名)
  url       String // 完整 http(s) 地址
  logo      String   @default("") // 可选 logo: http(s) 外链或站内 / 开头路径
  sortOrder Int      @default(0) // 升序展示
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// ==================== 用户反馈 ====================
model Feedback {
  id        String   @id @default(cuid())
  type      String   // bug | suggestion | praise | other
  contact   String?  // 可选联系方式 (邮箱/QQ)
  content   String   // 反馈正文
  url       String?  // 提交反馈时所在页地址
  siteId    String?
  userAgent String?
  ip        String?
  status    String   @default("new") // new | read | resolved | ignored
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([type])
  // [R11-c-2] 反滥用限流索引 —— /api/public/feedback POST 每次提交都执行
  // count({ ip, createdAt: { gte: 1小时前 } })(同 IP 5条/小时), 修前 Feedback 无 ip 索引,
  // 该无鉴权写路径的每次请求都是全表扫描(反馈行只增不删, 长期运行后无限流检查拖慢+扫描放大)。
  // 等值 ip + 范围 createdAt 的复合序与查询形态精确匹配
  @@index([ip, createdAt])
}
