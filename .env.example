# ============================================================
# 环境变量示例 — 复制为 .env 按需修改 (Docker 部署也可用 .env 自动加载)
#
# - 不注释的项(数据库/鉴权/日志)属核心必填或常调项, 给出常用默认值
# - 注释的项(以 # 开头)属可选高级项, 未设时各模块自行回落默认值 (零回归)
# - Docker 一键部署(install.sh)的变量也在此处统一列出, 便于运维一处查全
# ============================================================

# ===== 数据库 =====
# SQLite 库文件路径(相对项目根目录)。Docker 部署由 docker-compose 改为
# file:/app/db/custom.db, 宿主机通过 ./db 卷映射持久化。
DATABASE_URL=file:./db/custom.db

# ===== 后台鉴权 =====
# 后台登录密码(生产必填; 留空则进程启动时随机生成 16B 临时密码并打印到 stderr,
# 进程重启即失效 —— 仅作 dev 兜底, 生产环境务必显式设置)
ADMIN_PASSWORD=audit-fix-2025
# 会话签名密钥(留空则由 ADMIN_PASSWORD 派生 SHA256, 改密即令所有会话失效)
SESSION_SECRET=

# ===== 日志 (5-a 可观测性) =====
# 结构化日志输出级别: debug / info / warn / error
# - debug: dev 默认; 含 incoming request 等调试日志
# - info:  prod 默认; 仅业务关键事件 + health 收集
# - warn:  仅警告(批量错误/降级链触发等)
# - error: 仅未捕获异常 / DB 失败等
LOG_LEVEL=info

# ===== Docker 一键部署 (install.sh 读取, 非 Docker 部署可忽略) =====
# 装完即自动导入采集规则并启动「自动填充·」任务快速填满网站; 置 0 关闭
# AUTO_FILL=1
# 参与自动填充的站点 key 清单(逗号分隔; 默认不含 pili —— 霹雳书屋依赖 scrapling 桥,
# 属可选增强, 需要 --profile stealthy 场景, 见 DEPLOY.md 第五节)
# AUTO_FILL_RULES=fanqie,qimao,deqixs,bqg713,xjp,80ge,jinghua
# 期望的宿主机端口(用于占用检测提示; 实际端口在 docker-compose.yml ports 左侧改)
# HOST_PORT=3000
# 健康检查最长等待秒数(install.sh 探活主服务 + 自动填充引导)
# WAIT_TIMEOUT=300
# 克隆仓库地址(不填则用默认 https://github.com/u4399com-beep/heis.git)
# REPO_URL=
# 克隆目标目录(仅克隆模式生效; 默认 当前目录/novel-system)
# INSTALL_DIR=
# 国内镜像加速: 空=自动探测; 1=强制国内镜像; 0=禁用(全走海外官方源)
# USE_CN_MIRROR=
# 逗号分隔的 Docker Hub 加速器清单(覆盖默认; 仅 USE_CN_MIRROR=1 / 自动探测命中时生效)
# REGISTRY_MIRRORS=
# 1=不改动 /etc/docker/daemon.json (跳过加速器配置)
# SKIP_REGISTRY_MIRROR=0

# ===== Docker 构建参数 (Dockerfile / Dockerfile.scrapling ARG; install.sh 透传) =====
# 基础镜像(可直指国内镜像站, 例: docker.m.daocloud.io/oven/bun:1)
# BUN_IMAGE=oven/bun:1
# NODE_IMAGE=node:22-slim
# PYTHON_IMAGE=python:3.12-slim
# 包管理器源(空=官方源)
# NPM_REGISTRY=
# PIP_INDEX_URL=
# Debian apt 源(主机名段, 不带 scheme/路径, 例: mirrors.aliyun.com)
# DEBIAN_MIRROR=
# Playwright 浏览器下载源(空=官方源)
# PLAYWRIGHT_DOWNLOAD_HOST=

# ===== mini-services 桥接密钥 (可选, 多主机部署时使用) =====
# 5 个 Bun 代理(bqg713/qimao/deqixs/xjp/fetch-relay)共用 _shared/server.ts 的 BRIDGE_KEY 闸门:
# 留空 → 不校验 (单机部署默认; 主容器与代理同进程组 127.0.0.1 直连);
# 非空 → 所有非 /health 路由必须带 X-Bridge-Key 头(常量时间比较, 失败 401)
# BRIDGE_KEY=

# ===== 采集引擎 (src/lib/crawl/* 运行时调优, 高级用户) =====
# Obscura 隐身渲染页面池并发上限(默认 2; 提高=更快但内存/CPU 占用更高)
# OBSCURA_CONCURRENCY=2
#
# ---- 降级链桥地址(缺省已指向本机 mini-services 端口, 仅分布式部署需改) ----
# fetch-relay 桥(端口 3011; 主机直连被墙时的出网中继, 缺省 http://127.0.0.1:3011)
# FETCH_RELAY_URL=http://127.0.0.1:3011
# Scrapling 桥(端口 3012; python 隐身抓取, 缺省 http://127.0.0.1:3012)
# SCRAPLING_BRIDGE_URL=http://127.0.0.1:3012
#
# ---- 反反爬增强开关(全部缺省关闭, =1 开启; 关闭时行为与历史版本逐字节一致) ----
# 封面等二进制资源瞬态失败(网络层/408/5xx)退避 800ms 重试一次
# FETCH_BINARY_RETRY=1
# 响应体长度与声明校验(Content-Length 不符/截断检测)
# FETCH_BODY_LEN_CHECK=1
# [R11-b-EN-1] 尊重 429/503 的 Retry-After 头: 写入 per-host 限流冷却(上限 120s);
#   补 503 原先不走限流冷却的缺口, 缺省维持 30s 兜底口径
# RETRY_AFTER_HONOR=1
# [R11-b-EN-2] CF 挑战页强指纹(cf-chl/turnstile/challenge-platform 等)直接升级浏览器
#   渲染, 跳过对新种 Cookie 的重试(多敲盾页恶化 IP 信誉)
# CHALLENGE_ESCALATE=1
# [R11-b-EN-3] 响应体健全性启发: 长页无正文(纯 JS 壳/SPA 骨架)与乱码密度异常判为拦截,
#   走引擎降级/浏览器重渲染, 防空壳正文入库; JSON API 站自动豁免
# RESPONSE_SANITY=1
# [R11-b-EN-4] Accept-Language 方言池: 按 host 确定性抽取 q 权重变体(同站恒同值,
#   跨站分散), 弱化全站逐字节同值的全局指纹; 首选语言仍与 UA locale 自洽
# FETCH_AL_POOL=1
# [R9-e-4] 请求节奏画像: 连续被拦/慢响应时自动放缓 per-host 准入节奏(供 runner 参考)
# HOSTGATE_PACE_PROFILE=1
# 代理池健康评分: 按历史成败/延迟加权抽样(缺省纯随机)
# PROXY_HEALTH_SCORING=1
#
# ---- Obscura / cloak-browser 隐身细节(缺省关, =1 开启) ----
# 非标准 _devid brand 标识与 cookie(OBSCURA/CLOAK 双前缀分别作用于两套渲染层)
# OBSCURA_DEVID=1
# CLOAK_DEVID=1
# cloak-browser 多 UA 池与身份族谱(缺省单一 UA)
# CLOAK_UA_POOL=1
#
# ---- fetch-relay 桥自身调优(mini-services/fetch-relay) ----
# 中继并发上限(超限 503, 引擎按中继层失败处理; 缺省 32)
# RELAY_MAX_INFLIGHT=32
# =1 时禁止私网/回环目标出网(多主机部署防 SSRF; 单机默认不拦)
# RELAY_BLOCK_PRIVATE=1
