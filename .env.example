# ============================================================
# 环境变量示例 — 复制为 .env 按需修改
#
# [R69] 纯 Go 单体: 以下为 Go 二进制实际读取的全部环境变量(rg os.Getenv/envOr
#       全量盘点口径), 无任何死变量。注入方式三选一:
#       ① bash scripts/dev-go.sh 会自动 source 本文件(简单 KEY=VALUE 行)
#       ② systemd: EnvironmentFile=/path/to/.env
#       ③ 手动 shell: set -a; . ./.env; set +a 后再启动
#       (Go 二进制自身不读 .env —— 无 bun 时代的自动加载, 需上述任一注入)
# ============================================================

# ===== 服务 =====
# 监听端口(缺省 3000)
# PORT=3000

# ===== 数据库 =====
# SQLite 库文件路径(相对项目根目录; 缺省 db/custom.db)。
# 空库/缺表无需任何外部工具: 服务每次启动自动幂等建表(14 表),
# 规则表为空时后台自动播种运行态(见 MHGL_AUTO_SEED)。
# DB_PATH=db/custom.db

# ===== 后台鉴权 =====
# 后台登录密码(生产必填; 留空则回落编译期固定默认密码 audit-fix-2025 ——
# dev 环境登录页会展示此固定密码提示; 生产环境务必改为强密码覆盖,
# 自定义密码不会被登录页提示回显; 生产 GO_ENV=production 下留空=登录一律失败 fail-closed)
ADMIN_PASSWORD=audit-fix-2025
# 会话签名密钥(留空则回落编译期固定常量, 保证 .env 丢失时会话仍可验证;
# 生产环境务必显式设置独立随机值)
SESSION_SECRET=
# 运行形态: =production 时启用 fail-closed(密码/密钥缺失则后台不可登录)
# GO_ENV=production
# 会话 Cookie Secure 属性(生产 https 部署才开; 缺省关)
# - 关: 不附加 Secure —— http 直连或 http 沙箱预览可用(非 localhost 的 http 源上
#   带 Secure 的 Set-Cookie 会被浏览器拒收, 误开会直接断后台登录)
# - 开: 登录/注销 Set-Cookie 附加 Secure; 另外无论本开关, 请求经 https 到达
#   (TLS 直连或反代 X-Forwarded-Proto: https)时都会自动叠加 Secure
# 生产建议: 反代/Caddy 终结 TLS 并透传 X-Forwarded-Proto 即可全自动, 无需显式开
# COOKIE_SECURE=1

# ===== 资源 =====
# 内存软顶 MB(GOMEMLIMIT 同源口径; 缺省 600)
# MEM_LIMIT_MB=600
# 封面落盘目录(缺省 web/covers)
# COVER_DIR=web/covers

# ===== 建库/播种 (internal/bootstrap) =====
# 空库(规则表为 0 行)时自动播种运行态: 35 内置规则 + 16 分类 + 默认站点 +
# 三大部头采集任务(均 pending, 不自动开采集)。=0 关闭(纯手动运维)。
# MHGL_AUTO_SEED=1
# 显式引导 CLI(等价语义, 可在服务未启动时执行, 幂等):
#   .build/mhgl bootstrap

# ===== 采集引擎 (internal/crawl) =====
# ---- TLS 指纹(utls) ----
# =1 时按 host 稳定轮换 ClientHello 规格档(近三代 Chrome, FNV 归档:
# 同 host 恒同档, 异 host 打散 JA3); 缺省关 = 单一规格(历史行为零变化)
# MHGL_TLSFP_ROTATE=1
#
# ---- 免费代理池周期化 (internal/crawl/proxy) ----
# 收割间隔(支持 Go duration "6h"/"90m" 或纯数字按分钟; 缺省 6h;
# 下限钳 1m 防误配置轰炸源站)
# PROXY_HARVEST_INTERVAL=6h
#
# ---- 回调桥鉴权 (internal/crawl/bridge) ----
# x-go-callback-secret 取值链: payload 显式提供 → 本 env → 缺省 go-cb-2025-mhgl
# (单机部署用缺省即可; 多主机/暴露端口时设置强随机值)
# GO_CALLBACK_SECRET=

# ===== 测试 (仅 go test 消费, 运维无需关心) =====
# MHGL_STRESS_FULL=1 时启用引擎极限压测全矩阵(约 7 分钟, 本地 loopback)
